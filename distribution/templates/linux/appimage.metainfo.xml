<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>{{APP_ID}}</id>
  <name>{{APP_DISPLAY_NAME}}</name>
  <summary>A desktop port of Contre Jour</summary>
  <metadata_license>CC-BY-SA-4.0</metadata_license>
  <developer id="{{APP_ID}}">
    <name>yell0wsuit</name>
  </developer>
  <description>
    <p>Contre Jour DX is a desktop port of Contre Jour, built with .NET and SDL.</p>
  </description>
  <launchable type="desktop-id">{{APP_NAME}}.desktop</launchable>
  <url type="homepage">https://github.com/yell0wsuit/contrejour-dx</url>
  <provides>
    <binary>{{EXEC_NAME}}</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="{{VERSION}}" date="{{RELEASE_DATE}}"/>
  </releases>
</component>
