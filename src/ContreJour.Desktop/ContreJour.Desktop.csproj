<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ContreJour.Desktop</AssemblyName>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ContreJour.Desktop</RootNamespace>
    <!-- The decompiled projects carry their own AssemblyInfo.cs; this one has none. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <ProjectReference Include="../ContreJour/ContreJour.csproj" />
    <ProjectReference Include="../ContreJour.Desktop.Platform/ContreJour.Desktop.Platform.csproj" />
  </ItemGroup>

  <!-- Recreate the original appx layout next to the executable: Assets/ and Resources/ -->
  <PropertyGroup>
    <GameContents>$(MSBuildThisFileDirectory)../../GameContents/</GameContents>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(GameContents)**" Exclude="$(GameContents)Resources/**;$(GameContents)**/.DS_Store" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(GameContents)Resources/**" Exclude="$(GameContents)**/.DS_Store" Link="Resources/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Precompiled OpenGL sprite effect for MonoGameRenderer (built from MonoGame/Shaders/*.fx with
         tools/shaders/build-shaders.sh); the output path is the one the renderer opens. -->
    <Content Include="MonoGame/Shaders/*.ogl.mgfxo" Link="Mokus2D/Shaders/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
