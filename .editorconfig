# Remove the line below if you want to inherit .editorconfig settings from higher directories
root = true

[*]

#### Core EditorConfig Options ####

# Set default charset
charset = utf-8

# Indentation and spacing
indent_size = 4
indent_style = space
tab_width = 4

# New line preferences
end_of_line = lf
insert_final_newline = true

# Markdown, JSON, YAML, props and csproj files
[*.{md,json,yml,props,csproj}]

# Indentation and spacing
indent_size = 4
tab_width = 4

# C# files
[*.cs]

#### .NET Coding Conventions ####

# Organize usings
dotnet_separate_import_directive_groups = true
dotnet_sort_system_directives_first = true
dotnet_analyzer_diagnostic.category-Style.severity = warning

# Every file already uses file-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:warning

# Folders follow namespaces (never the other way round): namespaces are part of the type names
# level and clip content looks up at runtime (Default.Namespace.*, ContreJour.Clips.*).
dotnet_diagnostic.IDE0130.severity = warning

# Default.Namespace is part of the type names content looks up at runtime, so it can't be renamed
# to avoid Visual Basic keywords; members and parameters are still checked.
dotnet_code_quality.CA1716.analyzed_symbol_kinds = NamedType, Method, Property, Event, Parameter

# Plain data structs (vertices, pairs, rectangles, ranges) keep public fields, like XNA's Vector2:
# they're mutated in place and some rely on explicit field layout.
dotnet_code_quality.CA1051.exclude_structs = true

# Engine files that live in the game's Default.Namespace or extend System namespaces can't match
# their project's root namespace.
[Engine/*/{Default,System}/**.cs]
dotnet_diagnostic.IDE0130.severity = none
